<body class="page-donation">
  <canvas id="particle-background" aria-hidden="true"></canvas>
  <div class="background-effects" aria-hidden="true">
    <div class="bg-orb orb-a"></div>
    <div class="bg-orb orb-b"></div>
    <div class="bg-grid"></div>
  </div>

  <header class="site-header">
    <div class="container nav-shell">
      <a class="brand" href="#top" aria-label="Ir para o início">
        <img src="ErikrafT_Title_Logo.png" alt="Logo ErikrafT">
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Principal">
        <a href="/">Home</a>
        <a href="#about">Sobre</a>
        <a href="#social-links">Redes sociais</a>
        <a href="loja.html">Loja</a>
        <a href="donation.html">Doações</a>
