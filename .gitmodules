# ==============================================================================
# ErikrafT Drop™ — Git Submodules
# ==============================================================================
#
# OFFICIAL:
# Os submodules marcados como "Official" pertencem ao ecossistema do
# ErikrafT Drop™ e são mantidos pelo projeto.
#
# REFERENCES:
# Os submodules marcados como "Reference" são projetos de terceiros incluídos
# somente quando ainda são necessários pelo código/documentação do projeto.
#
# Créditos e direitos autorais permanecem com os respectivos autores e
# mantenedores de cada projeto.
# ==============================================================================

[submodule "Android"]
	path = Android
	url = https://github.com/erikraft/Drop-Android.git
	branch = master

[submodule "References/download-directory"]
	path = References/download-directory
	url = https://github.com/download-directory/download-directory.github.io.git
	branch = main

[submodule "References/onionshare-android"]
	path = References/onionshare-android
	url = https://github.com/onionshare/onionshare-android.git
	branch = main

[submodule "References/invizible"]
	path = References/invizible
	url = https://github.com/Gedsh/InviZible.git
	branch = master
