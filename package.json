{
  "name": "erikraft-drop",
  "version": "1.16.4",
  "type": "module",
  "description": "File sharing by ErikrafT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/index.js --rate-limit --auto-restart",
